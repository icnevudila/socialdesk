PORT=4317
# Optional official Meta credentials. Never put these in frontend code.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_API_VERSION=
# Explicit opt-in after connection and test publication have been verified.
ENABLE_PUBLISHING=false

# Hetzner ChatGPT / OmniStudio Manuel Oturum Servisi
OMNISTUDIO_GATEWAY_URL=http://167.233.201.31:3456
CHATGPT_API_KEY=
OPENAI_BASE_URL=http://167.233.201.31:3456/v1
OPENAI_MODEL=gpt-4o

# Required admin login; no built-in password.
ADMIN_PASSWORD=
AUTH_SECRET=
# Vercel: HTTPS origin of the persistent Oracle application (port 4318 tunnel).
SOCIALDESK_BACKEND_URL=
# Same random value on Oracle and Vercel, at least 32 characters.
SOCIALDESK_BRIDGE_TOKEN=
# Oracle: exact public frontend origins, comma separated.
ALLOWED_ORIGINS=https://socialdesk-sage.vercel.app
COOKIE_SECURE=true

# Local frontend only; persistent workers stay on Oracle.
SOCIALDESK_PROXY_MODE=false
SOCIALDESK_DISABLE_SCHEDULER=false
# Persistent backend: canonical HTTPS address for signed media delivery.
PUBLIC_BASE_URL=
# Optional separate key; AUTH_SECRET is used when empty.
MEDIA_SIGNING_SECRET=
